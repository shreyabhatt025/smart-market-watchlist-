NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Optional MongoDB persistence. If omitted, the demo uses an in-memory store.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/smart-market-watchlist

# mock (default) or real
MARKET_PROVIDER=mock
MOCK_SCENARIO=HIGH_ATTENTION
MARKET_CACHE_TTL_MS=45000

# Required only for a configured real provider adapter.
MARKET_API_URL=
MARKET_API_KEY=